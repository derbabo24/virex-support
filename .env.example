# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Default prefix for commands (e.g. . or !)
DEFAULT_PREFIX=.

# Bot Owner Discord ID (optional, for admin/owner-only commands)
OWNER_ID=0

# Database path (optional, defaults to bot_database.db)
DATABASE_PATH=bot_database.db
